# start with fastfetch, because if there are errors
# we want to see them under fastfetch
fastfetch
echo
echo

HISTFILE=~/.zsh_history
HISTSIZE=1000000
SAVEHIST=1000000
setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_SAVE_NO_DUPS

autoload -Uz compinit
compinit

# INSTALL the following: lsd duf dust bat btop neovim yazi starship

# some more ls aliases
alias ls='lsd'
alias lsa='lsd -la'
alias ll='lsd -l'
alias lls='lsd -lS'
alias llt='lsd -lt'

alias cat='bat -p' 
alias top='btop'
alias du='dust -d 1'
alias df='duf'
alias mc='yazi' # map midnight commander mc to yazi

export PATH=$HOME/bin:$HOME/.local/bin:$PATH

# AI secrets
if [[ -e "$HOME/.bash_secrets" ]]; then
    source $HOME/.bash_secrets
else
	echo "Bash Secrets is missing at : $HOME/.bash_secrets"
fi


PS1='[%n@%F{blue}%f %~]$ '