# Modify our PATH
PATH=$HOME/bin:$HOME/.local/bin:$PATH

if [ -d "/opt/homebrew/bin" ]; then
  PATH=/opt/homebrew/bin:$PATH
fi


# SOURCE this file at the end of the default .bashrc file for the system
#
# INSTALL the following: lsd duf dust bat(or batcat) btop neovim yazi

# some more ls aliases
alias ls='lsd'
alias lsa='lsd -la'
alias ll='lsd -l'
alias lls='lsd -lS'
alias llt='lsd -lt'

alias top='btop'
alias du='dust -d 1'
alias df='duf'
alias mc='yazi' # map midnight commander mc to yazi

if ! command -v batcat &> /dev/null
then
	alias cat='bat'
else
	alias cat='batcat'
fi


# pacman / yay utils
alias yaytop="yay -Qe"
alias yayaur="yay -Qm"


# AI
if [ -f "$HOME/.bash_secrets" ]; then
    source $HOME/.bash_secrets
else
	echo "Bash Secrets is missing at : $HOME/.bash_secrets"
fi

# PROMPT
PS1='[\u@\[\e[34m\]\[\e[m\] \w]\$ '
